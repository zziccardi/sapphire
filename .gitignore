# Ignore ANTLR-generated files, but keep __init__.py so the package can be
# imported correctly.
src/parser/gen/*
!src/parser/gen/__init__.py

tools/vscode-extension/coverage/
tools/vscode-extension/node_modules/
tools/vscode-extension/sapphire-*.vsix

.DS_Store
.antlr/
.coverage

# Ignore machine-specific files and directories.
.vscode/

*__pycache__*

# Python build & package artifacts
*.egg-info/
build/
dist/
*.pyc

lib/love2d/*.lua
lib/love2d/*.py
!lib/love2d/__init__.py

# Ignore the generated Lua file used for Love2D.
main.lua
*.map

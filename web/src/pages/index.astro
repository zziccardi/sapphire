---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sapphire Programming Language">
  <section class="mx-auto max-w-5xl px-4 py-24 text-center sm:px-6 lg:px-8">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-6xl">
      The Sapphire Programming Language
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-[var(--text-secondary)]">
      Systems-grade safety meets dynamic prototyping ergonomics.
    </p>
  </section>
</BaseLayout>

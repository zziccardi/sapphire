---
import BaseLayout from '../layouts/BaseLayout.astro';
import SapphireLogo from '../components/SapphireLogo.astro';
import { highlightCode } from '../lib/highlight';
import { withBase } from '../lib/url';

const showcaseTabs = [
  {
    id: 'proto',
    label: 'Prototypes & Arenas',
    summary:
      'Data-only prototypal delegation inside lexical Arenas: clones share live base fields and isolate mutations via copy-on-write.',
    code: `proto Goblin {
  var health: int = 50;
  var speed: float = 4.0;
  let name: String;
}

func spawn_wave() {
  var arena = Arena();
  var base = Goblin { name = "Goblin" } in arena;
  var elite = clone base {
    self.health = 150;  // Local property shadowing
  };
  base.speed = 5.5;     // Live delegation: elite.speed is now 5.5
  print(f"{elite.name}: {elite.health} HP, speed {elite.speed}");
}  // arena & prototypes cleaned up deterministically`,
  },
  {
    id: 'traits',
    label: 'Traits & Delegation',
    summary:
      'Multi-parent static structural delegation, zero-vtable traits, explicit var mutability, and named arguments.',
    code: `struct Position {
  var x: float = 0.0;
  var y: float = 0.0;
}

struct Health {
  var hp: int = 100;
}

// Multi-parent syntactic delegation: zero vtables, no slicing
struct Player: Position, Health {
  let name: String;
}

trait Damageable {
  var func take_damage(amount: int);
}

impl Damageable for Player {
  var func take_damage(amount: int) {
    self.hp = self.hp > amount ? self.hp - amount : 0;
  }
}

func strike(var target: Player, bonus: int = 0) {
  target.take_damage(amount = 15 + bonus);
}`,
  },
  {
    id: 'optionals',
    label: 'Optionals & Guard',
    summary:
      'No throwable exceptions. Safe guard unwrapping promotes validated bindings into the outer scope.',
    code: `struct Player {
  var health: int;
  let name: String;
}

func heal(var target_opt: Player?, amount: int): bool {
  guard var target ?= target_opt; target.health > 0 else {
    print("Target is missing or defeated.");
    return false;
  }
  target.health += amount;
  return true;
}`,
  },
  {
    id: 'raii',
    label: 'RAII & Coroutines',
    summary:
      'Deterministic LIFO __del__ destructors paired with statically typed stackless Coroutine<T>.',
    code: `struct ScopedTimer {
  let label: String;
}

impl ScopedTimer {
  func __del__() {
    print(f"Finished: {self.label}");
  }
}

func ticker(): Coroutine<int> {
  var step: int = 0;
  while step < 3 {
    step += 1;
    yield step;
  }
}`,
  },
  {
    id: 'interop',
    label: 'Host Interop & Hot-Reload',
    summary:
      'Zero-overhead @extern and @export bindings for Lua and Python host runtimes, plus @on_reload hooks.',
    code: `trait StrEncoder {
  @export("encode")
  func to_bytes(text: String, encoding: String = "utf-8"): String;
}

@extern
var str: StrEncoder;

@export("app.greet")
func greet(name: String): String {
  return str.to_bytes(f"Hello, {name}!");
}

@on_reload
func handle_reload() {
  print("[Hot Reload] Logic updated without resetting state.");
}`,
  },
];

const highlightedTabs = await Promise.all(
  showcaseTabs.map(async (tab) => ({
    ...tab,
    html: await highlightCode(tab.code, 'sapphire'),
  })),
);

const hostSapphireCode = `import lib.love2d.enums;
import lib.love2d.graphics;
import lib.love2d.love2d;

let love = love2d.love;
var hero_x = 200.0;

@export("love.update")
func update(dt: float) {
  if love.keyboard.isDown(enums.KeyCode.Right) {
    hero_x += 240.0 * dt;
  }
}

@export("love.draw")
func draw() {
  love.graphics.setColorRgba(0.3, 0.75, 1.0);
  love.graphics.circle(
      mode = enums.DrawMode.Fill, x = hero_x, y = 180.0, radius = 24.0);
}

@on_reload
func on_reload() {
  print("Hot-reloaded while preserving hero_x!");
}`;

const hostLuaCode = `-- Direct Lua output emitted by Sapphire (zero wrapper overhead)
local enums = require("lib.love2d.enums")
local graphics = require("lib.love2d.graphics")
local love2d = require("lib.love2d.love2d")

local love = love2d.love
local hero_x = 200.0

function love.update(dt)
  if love.keyboard.isDown(enums.KeyCode.Right) then
    hero_x = hero_x + (240.0 * dt)
  end
end

function love.draw()
  love.graphics.setColor(0.3, 0.75, 1.0)
  love.graphics.circle(enums.DrawMode.Fill, hero_x, 180.0, 24.0)
end

function on_reload()
  print("Hot-reloaded while preserving hero_x!")
end`;

const [hostSapphireHtml, hostLuaHtml, cliHtml] = await Promise.all([
  highlightCode(hostSapphireCode, 'sapphire'),
  highlightCode(hostLuaCode, 'lua'),
  highlightCode(
    `# Install the Sapphire CLI
pipx install sapphire-lang

# Run standalone scripts on Python or Lua
sapphire samples/overview.sp
sapphire samples/overview.sp -t lua

# Run a Love2D project with live hot-reloading & source maps
sapphire run samples/love2d_demo.sp -t love2d -o main.lua --dev

# Type-check & run native @test suites
sapphire check samples/overview.sp -t lua
sapphire test`,
    'bash',
  ),
]);
---

<BaseLayout title="Sapphire Programming Language">
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[var(--border-subtle)]">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--accent-glow),_transparent_65%)]"
    ></div>
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="flex flex-col items-center text-center">
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3.5 py-1 text-xs font-medium text-[var(--text-secondary)] shadow-sm"
        >
          <SapphireLogo size={16} />
          <span>Compiles to Python &amp; Lua &middot; Host interop &amp; hot-reload &middot; Native compiler on roadmap</span>
        </div>

        <h1 class="max-w-4xl text-4xl font-extrabold tracking-tight sm:text-6xl">
          Systems-grade safety.{' '}
          <span class="bg-gradient-to-r from-sky-400 via-blue-500 to-indigo-500 bg-clip-text text-transparent">
            Dynamic-language ergonomics.
          </span>
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--text-secondary)]">
          Sapphire is a statically typed general-purpose language combining
          zero-vtable polymorphism, scope-bound reference safety without
          lifetime annotations, and opt-in prototypes in lexical arenas—with
          zero-overhead Lua and Python host interop, including built-in Love2D
          bindings and live hot-reloading.
        </p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-3.5">
          <a
            href={withBase('/playground')}
            class="inline-flex items-center gap-2 rounded-xl bg-[var(--accent-primary)] px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[var(--accent-hover)]"
          >
            Try in Playground
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            href={withBase('/docs/quickstart')}
            class="inline-flex items-center gap-2 rounded-xl border border-[var(--border-strong)] bg-[var(--bg-surface)] px-5 py-3 text-sm font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-secondary)]"
          >
            Quickstart Guide
          </a>
          <a
            href={withBase('/docs/spec')}
            class="inline-flex items-center gap-2 rounded-xl border border-transparent px-4 py-3 text-sm font-semibold text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)]"
          >
            Read the Spec
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Design Pillars -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6">
        <div class="text-xs font-semibold uppercase tracking-wider text-[var(--accent-primary)]">
          01 / Polymorphism
        </div>
        <h2 class="mt-2 text-lg font-bold">Zero-Vtable by Default</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
          Traits compile via monomorphization and closed tagged unions. Multi-parent
          structural delegation composes layouts with no up-casting or object slicing.
        </p>
      </div>

      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6">
        <div class="text-xs font-semibold uppercase tracking-wider text-[var(--accent-primary)]">
          02 / Memory Safety
        </div>
        <h2 class="mt-2 text-lg font-bold">Scope-Bound Exclusivity</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
          Non-primitives pass by constant reference by default. Explicit <code>var</code>{' '}
          mutability and call-site aliasing checks replace lifetime annotations.
        </p>
      </div>

      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6">
        <div class="text-xs font-semibold uppercase tracking-wider text-[var(--accent-primary)]">
          03 / Resource Control
        </div>
        <h2 class="mt-2 text-lg font-bold">RAII &amp; Prototypal Arenas</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
          Deterministic LIFO <code>__del__</code> destructors pair with opt-in{' '}
          <code>proto</code> / <code>clone</code> delegation and copy-on-write safety
          inside lexical <code>Arena</code> scopes.
        </p>
      </div>

      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6">
        <div class="text-xs font-semibold uppercase tracking-wider text-[var(--accent-primary)]">
          04 / Host Environments
        </div>
        <h2 class="mt-2 text-lg font-bold">Host Interop &amp; Hot-Reload</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
          Bind Lua and Python host APIs with <code>@extern</code> / <code>@export</code>{' '}
          (including built-in Love2D bindings), state-preserving <code>--dev</code>{' '}
          hot-reloading, and source-mapped error traces.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Code Showcase -->
  <section class="border-y border-[var(--border-subtle)] bg-[var(--bg-secondary)]/40 py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Sapphire at a Glance</h2>
          <p class="mt-1 text-sm text-[var(--text-secondary)]">
            Explore core language constructs with static type checking and deterministic cleanup.
          </p>
        </div>
        <a
          href={withBase('/playground')}
          class="text-sm font-semibold text-[var(--accent-primary)] hover:underline"
        >
          Open interactive playground &rarr;
        </a>
      </div>

      <div class="mt-6">
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Sapphire feature examples">
          {
            highlightedTabs.map((tab, idx) => (
              <button
                type="button"
                role="tab"
                id={`tab-${tab.id}`}
                data-tab-target={tab.id}
                aria-controls={`panel-${tab.id}`}
                aria-selected={idx === 0 ? 'true' : 'false'}
                class={`tab-btn rounded-lg border px-3.5 py-2 text-sm font-medium transition-colors ${
                  idx === 0
                    ? 'border-[var(--accent-primary)] bg-[var(--accent-glow)] text-[var(--accent-primary)]'
                    : 'border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
                }`}
              >
                {tab.label}
              </button>
            ))
          }
        </div>

        <div class="mt-4">
          {
            highlightedTabs.map((tab, idx) => (
              <div
                role="tabpanel"
                id={`panel-${tab.id}`}
                aria-labelledby={`tab-${tab.id}`}
                data-tab-panel={tab.id}
                class={idx === 0 ? 'block' : 'hidden'}
              >
                <p class="mb-3 text-sm text-[var(--text-secondary)]">{tab.summary}</p>
                <div set:html={tab.html} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Built for Host Environments Spotlight -->
  <section class="border-b border-[var(--border-subtle)] py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div class="max-w-2xl">
          <div class="text-xs font-semibold uppercase tracking-wider text-[var(--accent-primary)]">
            Zero-Overhead Host Interop
          </div>
          <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">
            Built for Host Environments
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            Model external Lua or Python APIs directly with traits,{' '}
            <code>@extern</code>, and <code>@export</code>—no FFI glue or runtime
            wrappers. Here is how Sapphire's built-in <strong>Love2D</strong>{' '}
            bindings compile straight to idiomatic Lua:
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href={withBase('/docs/host-interop')}
            class="text-sm font-semibold text-[var(--accent-primary)] hover:underline"
          >
            Host Interop &amp; Love2D Guide &rarr;
          </a>
        </div>
      </div>

      <div class="mt-6 grid gap-5 lg:grid-cols-2">
        <div class="flex flex-col overflow-hidden rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
          <div class="flex items-center justify-between border-b border-[var(--border-subtle)] px-4 py-2.5 text-xs font-semibold text-[var(--text-secondary)]">
            <span>game.sp</span>
            <span class="rounded bg-[var(--accent-glow)] px-2 py-0.5 text-[var(--accent-primary)]">
              Typed Sapphire
            </span>
          </div>
          <div class="flex-1 overflow-x-auto [&>pre]:!my-0 [&>pre]:!rounded-none [&>pre]:!border-0" set:html={hostSapphireHtml} />
        </div>

        <div class="flex flex-col overflow-hidden rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
          <div class="flex items-center justify-between border-b border-[var(--border-subtle)] px-4 py-2.5 text-xs font-semibold text-[var(--text-secondary)]">
            <span>main.lua</span>
            <span class="rounded bg-[var(--bg-secondary)] px-2 py-0.5 text-[var(--text-secondary)]">
              Generated Lua
            </span>
          </div>
          <div class="flex-1 overflow-x-auto [&>pre]:!my-0 [&>pre]:!rounded-none [&>pre]:!border-0" set:html={hostLuaHtml} />
        </div>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-4">
          <h3 class="text-sm font-bold text-[var(--text-primary)]">
            Modular <code>lib.love2d</code> Bindings
          </h3>
          <p class="mt-1.5 text-xs leading-relaxed text-[var(--text-secondary)]">
            Typed graphics, input, timer, and string enums catch API typos at compile
            time, alongside the same <code>@extern</code>/<code>@export</code> model
            for Python host libraries.
          </p>
        </div>

        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-4">
          <h3 class="text-sm font-bold text-[var(--text-primary)]">
            In-Place <code>--dev</code> Hot-Reload
          </h3>
          <p class="mt-1.5 text-xs leading-relaxed text-[var(--text-secondary)]">
            Watches <code>.sp</code> files, patches struct and prototype metatables
            without losing live application state, and runs{' '}
            <code>@on_reload</code> hooks automatically.
          </p>
        </div>

        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-4">
          <h3 class="text-sm font-bold text-[var(--text-primary)]">
            Source Maps &amp; Crash Demangling
          </h3>
          <p class="mt-1.5 text-xs leading-relaxed text-[var(--text-secondary)]">
            Emits Source Map v3 (<code>.lua.map</code>) and hooks Love2D's error
            screen so stack traces point back to your original <code>.sp</code>{' '}
            files and line numbers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Quickstart & Comparisons CTA -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
          Built for rapid iteration today
        </h2>
        <p class="mt-3 text-[var(--text-secondary)]">
          Install the CLI, pair it with the VS Code LSP extension, run native{' '}
          <code>@test</code> suites, or iterate in live hot-reload mode. Coming
          from another scripting or systems language? Read our side-by-side
          comparisons.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={withBase('/compare/cpp')}
            class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3.5 py-2 text-sm font-medium hover:border-[var(--border-strong)]"
          >
            Sapphire vs C++
          </a>
          <a
            href={withBase('/compare/lua')}
            class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3.5 py-2 text-sm font-medium hover:border-[var(--border-strong)]"
          >
            Sapphire vs Lua
          </a>
          <a
            href={withBase('/compare/rust')}
            class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3.5 py-2 text-sm font-medium hover:border-[var(--border-strong)]"
          >
            Sapphire vs Rust
          </a>
          <a
            href={withBase('/compare/swift')}
            class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3.5 py-2 text-sm font-medium hover:border-[var(--border-strong)]"
          >
            Sapphire vs Swift
          </a>
        </div>
      </div>

      <div set:html={cliHtml} />
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const buttons = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('[data-tab-panel]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab-target');
        buttons.forEach((b) => {
          const active = b.getAttribute('data-tab-target') === target;
          b.setAttribute('aria-selected', String(active));
          b.className = active
            ? 'tab-btn rounded-lg border px-3.5 py-2 text-sm font-medium transition-colors border-[var(--accent-primary)] bg-[var(--accent-glow)] text-[var(--accent-primary)]'
            : 'tab-btn rounded-lg border px-3.5 py-2 text-sm font-medium transition-colors border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
        });
        panels.forEach((panel) => {
          panel.classList.toggle(
            'hidden',
            panel.getAttribute('data-tab-panel') !== target,
          );
        });
      });
    });
  })();
</script>

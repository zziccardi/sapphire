---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBox from '../../components/SearchBox.astro';
import { DOC_PAGES } from '../../data/docs';
import { renderDocFile } from '../../lib/markdown';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  return DOC_PAGES.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const rendered = await renderDocFile(doc.file);
const groups = ['Getting Started', 'Language Reference', 'Compiler & Testing'] as const;
const hasMermaid = rendered.html.includes('class="mermaid"');
---

<BaseLayout title={`${doc.title} | Sapphire Docs`} description={doc.summary}>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col justify-between gap-4 border-b border-[var(--border-subtle)] pb-6 sm:flex-row sm:items-center">
      <div class="flex items-center gap-2 text-sm text-[var(--text-secondary)]">
        <a href={withBase('/docs')} class="hover:text-[var(--text-primary)]">Docs</a>
        <span>/</span>
        <span class="text-[var(--text-primary)]">{doc.title}</span>
      </div>
      <SearchBox />
    </div>

    <div class="grid gap-10 lg:grid-cols-[240px_1fr_220px]">
      <!-- Left Sidebar -->
      <aside class="hidden lg:block" data-pagefind-ignore>
        <nav aria-label="Documentation" class="sticky top-24 space-y-6">
          {
            groups.map((group) => (
              <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                  {group}
                </div>
                <ul class="mt-2 space-y-1">
                  {DOC_PAGES.filter((d) => d.group === group).map((item) => {
                    const active = item.slug === doc.slug;
                    return (
                      <li>
                        <a
                          href={withBase(`/docs/${item.slug}`)}
                          class={`block rounded-lg px-3 py-1.5 text-sm transition-colors ${
                            active
                              ? 'bg-[var(--accent-glow)] font-semibold text-[var(--accent-primary)]'
                              : 'text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]'
                          }`}
                        >
                          {item.title}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      <!-- Main Content -->
      <article class="sapphire-prose min-w-0" data-pagefind-body set:html={rendered.html} />

      <!-- Right TOC -->
      <aside class="hidden xl:block" data-pagefind-ignore>
        {
          rendered.headings.length > 0 && (
            <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-4">
              <div class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                On this page
              </div>
              <ul class="mt-3 space-y-1.5 text-xs">
                {rendered.headings
                  .filter((h) => h.depth === 2)
                  .map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class="block text-[var(--text-secondary)] hover:text-[var(--accent-primary)]"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>

{
  hasMermaid && (
    <script type="module">
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
      const theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'default';
      mermaid.initialize({ startOnLoad: true, theme });
    </script>
  )
}

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBox from '../../components/SearchBox.astro';
import { DOC_PAGES } from '../../data/docs';
import { withBase } from '../../lib/url';

const groups = ['Getting Started', 'Language Reference', 'Compiler & Testing'] as const;
---

<BaseLayout
  title="Documentation | Sapphire"
  description="Sapphire language specification, built-ins, standard library, compiler architecture, and testing."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-6 border-b border-[var(--border-subtle)] pb-8 md:flex-row md:items-end">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Documentation</h1>
        <p class="mt-2 max-w-2xl text-[var(--text-secondary)]">
          Synced directly from <code>docs/</code> in the Sapphire repository.
        </p>
      </div>
      <SearchBox />
    </div>

    <div class="mt-10 space-y-12">
      {
        groups.map((group) => (
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-[var(--accent-primary)]">
              {group}
            </h2>
            <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {DOC_PAGES.filter((d) => d.group === group).map((doc) => (
                <a
                  href={withBase(`/docs/${doc.slug}`)}
                  class="group rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-5 transition-colors hover:border-[var(--accent-primary)]"
                >
                  <h3 class="text-lg font-bold group-hover:text-[var(--accent-primary)]">
                    {doc.title}
                  </h3>
                  <p class="mt-2 text-sm text-[var(--text-secondary)]">{doc.summary}</p>
                  <div class="mt-4 text-xs font-medium text-[var(--text-muted)]">
                    docs/{doc.file}
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SAMPLE_EXAMPLES, readSampleSource } from '../../data/examples';
import { highlightCode } from '../../lib/highlight';
import { withBase } from '../../lib/url';

const categories = [
  'All',
  'Overview',
  'Memory & Arenas',
  'Concurrency & Control Flow',
  'Game Dev & Love2D',
];

const renderedExamples = await Promise.all(
  SAMPLE_EXAMPLES.map(async (ex) => {
    const source = readSampleSource(ex.file);
    const html = await highlightCode(source, 'sapphire');
    const lineCount = source.trimEnd().split('\n').length;
    return { ...ex, html, lineCount };
  }),
);
---

<BaseLayout
  title="Examples | Sapphire"
  description="Curated Sapphire programming language examples from samples/."
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="border-b border-[var(--border-subtle)] pb-8">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Sapphire Examples</h1>
      <p class="mt-3 max-w-2xl text-[var(--text-secondary)]">
        Real, runnable programs sourced directly from <code>samples/</code> in the
        repository. Open any compatible example in the browser playground to inspect
        generated Python or Lua output.
      </p>

      <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Filter examples">
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              data-category-btn={cat}
              class={`cat-btn rounded-lg border px-3.5 py-1.5 text-sm font-medium transition-colors ${
                idx === 0
                  ? 'border-[var(--accent-primary)] bg-[var(--accent-glow)] text-[var(--accent-primary)]'
                  : 'border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
              }`}
            >
              {cat}
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-8 space-y-10">
      {
        renderedExamples.map((ex) => (
          <article
            data-example-category={ex.category}
            id={ex.slug}
            class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 shadow-sm"
          >
            <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-md bg-[var(--accent-glow)] px-2.5 py-0.5 text-xs font-semibold text-[var(--accent-primary)]">
                    {ex.category}
                  </span>
                  <span class="text-xs text-[var(--text-muted)]">
                    samples/{ex.file} &middot; {ex.lineCount} lines
                  </span>
                </div>
                <h2 class="mt-2 text-xl font-bold">{ex.title}</h2>
                <p class="mt-1 text-sm text-[var(--text-secondary)]">{ex.description}</p>
              </div>

              <div class="flex shrink-0 items-center gap-2">
                {ex.runnableInPlayground && (
                  <a
                    href={withBase(`/playground?sample=${ex.slug}`)}
                    class="rounded-lg bg-[var(--accent-primary)] px-3.5 py-2 text-xs font-semibold text-white hover:bg-[var(--accent-hover)]"
                  >
                    Try in Playground &rarr;
                  </a>
                )}
                <a
                  href={`https://github.com/zziccardi/sapphire/blob/main/samples/${ex.file}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg border border-[var(--border-subtle)] px-3 py-2 text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
                >
                  Source
                </a>
              </div>
            </div>

            <div class="mt-4 max-h-[28rem] overflow-y-auto rounded-xl">
              <div set:html={ex.html} />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const btns = document.querySelectorAll('.cat-btn');
    const cards = document.querySelectorAll('[data-example-category]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-category-btn');
        btns.forEach((b) => {
          const active = b.getAttribute('data-category-btn') === selected;
          b.className = active
            ? 'cat-btn rounded-lg border px-3.5 py-1.5 text-sm font-medium transition-colors border-[var(--accent-primary)] bg-[var(--accent-glow)] text-[var(--accent-primary)]'
            : 'cat-btn rounded-lg border px-3.5 py-1.5 text-sm font-medium transition-colors border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
        });
        cards.forEach((card) => {
          const cat = card.getAttribute('data-example-category');
          const visible = selected === 'All' || cat === selected;
          card.classList.toggle('hidden', !visible);
        });
      });
    });
  })();
</script>

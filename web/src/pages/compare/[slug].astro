---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderDocFile } from '../../lib/markdown';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  return [
    { params: { slug: 'rust' }, props: { file: 'rust_comparison.md', label: 'Sapphire vs Rust' } },
    { params: { slug: 'cpp' }, props: { file: 'cpp_comparison.md', label: 'Sapphire vs C++' } },
    { params: { slug: 'swift' }, props: { file: 'swift_comparison.md', label: 'Sapphire vs Swift' } },
  ];
}

const { file, label } = Astro.props;
const rendered = await renderDocFile(file);
---

<BaseLayout title={`${rendered.title || label} | Sapphire`}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-2 text-sm text-[var(--text-secondary)]">
      <a href={withBase('/compare')} class="hover:text-[var(--text-primary)]">
        Comparisons
      </a>
      <span>/</span>
      <span class="text-[var(--text-primary)]">{label}</span>
    </div>

    <div class="grid gap-10 lg:grid-cols-[1fr_240px]">
      <article class="sapphire-prose min-w-0" set:html={rendered.html} />

      {
        rendered.headings.length > 0 && (
          <aside class="hidden lg:block">
            <div class="sticky top-24 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-4">
              <div class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                On this page
              </div>
              <ul class="mt-3 space-y-1.5 text-sm">
                {rendered.headings
                  .filter((h) => h.depth === 2)
                  .map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class="block text-[var(--text-secondary)] hover:text-[var(--accent-primary)]"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';

const comparisons = [
  {
    slug: 'rust',
    title: 'Sapphire vs Rust',
    tagline: 'Scope-bound reference exclusivity vs explicit lifetimes and borrow-checker annotations.',
    highlights: [
      'Call-site aliasing checks without lifetime parameters',
      'Lexical Arenas & proto/clone for cyclic or dynamic graphs',
      'Optionals (T?) and guard clauses instead of Result/Option turbofish',
    ],
  },
  {
    slug: 'cpp',
    title: 'Sapphire vs C++',
    tagline: 'Deterministic RAII and structural delegation without headers, vtables, or undefined behavior.',
    highlights: [
      'No virtual-method tables by default; traits use static monomorphization',
      'No struct up-casting or object slicing',
      'No throwable exceptions or invisible stack unwinding',
    ],
  },
  {
    slug: 'swift',
    title: 'Sapphire vs Swift',
    tagline: 'Familiar guard/optional ergonomics with deterministic RAII instead of ARC.',
    highlights: [
      'Deterministic __del__ destructors & RVO instead of reference counting cycles',
      'Explicit var mutability in parameters and methods',
      'Opt-in prototypal delegation for rapid game/simulation iteration',
    ],
  },
];
---

<BaseLayout
  title="Language Comparisons | Sapphire"
  description="How Sapphire compares with Rust, C++, and Swift."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
        How Sapphire Compares
      </h1>
      <p class="mt-3 text-[var(--text-secondary)]">
        Side-by-side design trade-offs, memory models, and code examples comparing
        Sapphire with Rust, C++, and Swift.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        comparisons.map((item) => (
          <a
            href={withBase(`/compare/${item.slug}`)}
            class="group flex flex-col justify-between rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 transition-colors hover:border-[var(--accent-primary)]"
          >
            <div>
              <h2 class="text-xl font-bold group-hover:text-[var(--accent-primary)]">
                {item.title}
              </h2>
              <p class="mt-2 text-sm text-[var(--text-secondary)]">{item.tagline}</p>
              <ul class="mt-4 space-y-2 text-sm text-[var(--text-secondary)]">
                {item.highlights.map((h) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1 text-[var(--accent-primary)]">&bull;</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="mt-6 text-sm font-semibold text-[var(--accent-primary)]">
              Read comparison &rarr;
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

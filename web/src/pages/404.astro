---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Page Not Found | Sapphire">
  <section class="mx-auto max-w-2xl px-4 py-28 text-center sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-widest text-[var(--accent-primary)]">
      404
    </p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight">Page not found</h1>
    <p class="mt-4 text-[var(--text-secondary)]">
      The page you are looking for does not exist or has moved.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a
        href={withBase('/')}
        class="rounded-xl bg-[var(--accent-primary)] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[var(--accent-hover)]"
      >
        Back to Home
      </a>
      <a
        href={withBase('/docs')}
        class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-5 py-2.5 text-sm font-semibold hover:bg-[var(--bg-secondary)]"
      >
        Browse Docs
      </a>
    </div>
  </section>
</BaseLayout>

[run]
branch = True
source =
    sapphire
    tools/vscode-extension/scripts
omit =
    sapphire/parser/gen/*
    sapphire/run_*.py
    *__init__.py
    *_test.py
    /tmp/*
    /var/*
    /private/var/*

[report]
show_missing = True
omit =
    sapphire/parser/gen/*
    sapphire/run_*.py
    *__init__.py
    *_test.py
    /tmp/*
    /var/*
    /private/var/*


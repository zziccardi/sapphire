[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pip_conf_index_global"

[packages]
antlr4-python3-runtime = "*"
pygls = "*"

[dev-packages]
coverage = "*"

[requires]
python_version = "3.14"

[scripts]
sapphire = "python -m src.cli.sapphire"
build = "python -m src.cli.sapphire build"
run = "python -m src.cli.sapphire run"
test = "sh -c 'python -m unittest discover -s src -p \"*_test.py\" && python -m unittest discover -s tools/vscode-extension/scripts -p \"*_test.py\"'"
coverage = "sh -c 'coverage run -m unittest discover -s src -p \"*_test.py\" && coverage run -a -m unittest discover -s tools/vscode-extension/scripts -p \"*_test.py\" && coverage report -m && coverage html'"

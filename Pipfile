[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pip_conf_index_global"

[packages]
antlr4-python3-runtime = "*"
pygls = "*"
llvmlite = "*"

[dev-packages]
coverage = "*"
ruff = "*"
pyright = "*"
build = "*"
twine = "*"

[requires]
python_version = "3"

[scripts]
antlr = "antlr -Dlanguage=Python3 -visitor -o sapphire/parser/gen -Xexact-output-dir grammar/Sapphire.g4"
sapphire = "python -m sapphire.cli.sapphire"
build = "python -m sapphire.cli.sapphire build"
run = "python -m sapphire.cli.sapphire run"
test = "sh -c 'python -m unittest discover -s sapphire -p \"*_test.py\" && python -m unittest discover -s tools/vscode-extension/scripts -p \"*_test.py\"'"
test-fast = "python tools/parallel_test.py"
check-samples = "python -m unittest sapphire/code_gen/samples_compilation_test.py"
coverage = "sh -c 'coverage run --source=sapphire,tools/vscode-extension/scripts -m unittest discover -s sapphire -p \"*_test.py\" && coverage run -a --source=sapphire,tools/vscode-extension/scripts -m unittest discover -s tools/vscode-extension/scripts -p \"*_test.py\" && coverage report -m --fail-under=93 && coverage html'"
coverage-lua = "python tools/lua_coverage.py"
lint = "ruff check sapphire/"
typecheck = "pyright"

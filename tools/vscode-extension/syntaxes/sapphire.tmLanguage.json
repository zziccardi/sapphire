{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sapphire",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sapphire",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sapphire",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.sapphire",
          "begin": "f\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.sapphire"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.sapphire"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.sapphire",
              "match": "\\\\.|\\{\\{|\\}\\}"
            },
            {
              "name": "meta.interpolation.sapphire",
              "begin": "\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.sapphire"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.sapphire"
                }
              },
              "patterns": [
                {
                  "include": "#interpolation-braces"
                },
                {
                  "include": "#strings"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#keywords"
                },
                {
                  "include": "#types"
                },
                {
                  "include": "#identifiers"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.sapphire",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sapphire",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#interpolation-braces"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.sapphire",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.sapphire",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sapphire",
          "match": "\\b(as|break|clone|continue|else|export|for|guard|if|import|in|match|move|return|while|yield)\\b"
        },
        {
          "name": "storage.modifier.sapphire",
          "match": "\\b(enum|func|impl|let|proto|static|struct|trait|var)\\b"
        },
        {
          "name": "constant.language.sapphire",
          "match": "\\b(false|none|self|true)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.sapphire",
          "match": "\\b(String|bool|float|int|void)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.sapphire",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.sp"
}

{
  "name": "sapphire",
  "displayName": "Sapphire",
  "description": "Language support and semantic highlighting for the Sapphire programming language",
  "version": "0.1.0",
  "publisher": "zziccardi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zziccardi/sapphire.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "type": "module",
  "contributes": {
    "languages": [
      {
        "id": "sapphire",
        "aliases": [
          "Sapphire",
          "sapphire"
        ],
        "extensions": [
          ".sp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sapphire",
        "scopeName": "source.sp",
        "path": "./syntaxes/sapphire.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[sapphire]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": true
      }
    },
    "configuration": {
      "type": "object",
      "title": "Sapphire",
      "properties": {
        "sapphire.lsp.path": {
          "type": "string",
          "default": "sapphire",
          "description": "Path or executable name for the Sapphire CLI (e.g. 'sapphire' or '/usr/local/bin/sapphire')."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --import ./test/register.mjs --test test/extension.test.mjs",
    "coverage": "npm run compile && node --import ./test/register.mjs --test --experimental-test-coverage test/extension.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
